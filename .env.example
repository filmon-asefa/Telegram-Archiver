# ============================================================
# Telegram Archiver Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
#
# WARNING: Never commit .env to version control!
# WARNING: Never share your .env file — it contains sensitive credentials.
# ============================================================

# Get these from https://my.telegram.org -> API development tools
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here

# Your phone number in international format, e.g. +15551234567
TG_PHONE=+10000000000

# Where the Telethon session file and database live
SESSION_NAME=telegram_archive
DB_PATH=./data/telegram_archive.db
MEDIA_DIR=./data/media

# Set to true to also download voice notes / documents / photos
DOWNLOAD_MEDIA=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Frontend overrides (auto-detected if not set)
# ARCHIVER_DB_PATH=./data/telegram_archive.db
# ARCHIVER_MEDIA_ROOT=./data/media
